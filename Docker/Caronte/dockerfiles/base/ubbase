FROM ubuntu
ARG USUARIO
ARG PASSWORD
RUN apt update && apt install -yq --no-install-recommends \ 
    nano \
    git curl \
    net-tools iputils-ping \
    sudo
#copiar los scrip's del entrypoint (sc ppal ---> otrs sc' personalizadas)
RUN mkdir -p /root/admin/base
WORKDIR /root/admin/base
COPY ./dockerfiles/base/admin/start.sh .
RUN chmod +x ./start.sh

RUN useradd -rm -d /home/${USUARIO} -s /bin/bash ${USUARIO}
RUN echo "${USUARIO}:${PASSWORD}" | chpasswd 
RUN echo "Bienvenido a la empresa, ${USUARIO}" > /home/${USUARIO}/hola.txt

#CMD [ "tail", "-f", "/dev/null" ]

ENTRYPOINT [ "/root/admin/start.sh" ]